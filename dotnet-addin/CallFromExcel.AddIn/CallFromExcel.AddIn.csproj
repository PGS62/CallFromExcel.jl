<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- Target .NET Framework 4.8, not modern .NET: see the August plan. Only one .NET
         runtime version can load per Excel process (compatibility risk with other
         add-ins), and the COM-server + single-file-packing combination isn't clearly
         documented as proven under modern .NET. -->
    <Platforms>x64</Platforms>
    <RootNamespace>CallFromExcel.AddIn</RootNamespace>
    <AssemblyName>CallFromExcel.AddIn</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- We write ComVisible(false) at the assembly level ourselves (AssemblyInfo.cs) and
         opt specific classes in individually. SDK-style auto-generated AssemblyInfo
         would otherwise collide with that. -->
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
    <!-- No PDB for Release: we do not ship one, and the PDB path it would embed in the DLL
         depends on where the repo is cloned, which would stop dist\ being reproducible. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="ExcelDna.IntelliSense" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the ribbon's message boxes (Ribbon.cs). Part of .NET Framework, so nothing to ship. -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- dist\ is committed, so Pkg.add users get a built add-in; test/runtests.jl checks it is current. -->
  <Target Name="UpdateDist" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Update-Dist.ps1&quot; -ExcelDnaIntegrationPath &quot;@(ReferencePath->WithMetadataValue('Filename','ExcelDna.Integration'))&quot;" />
  </Target>

</Project>
